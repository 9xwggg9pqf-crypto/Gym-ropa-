# Copia este fichero como .env.local (desarrollo) o configura estas variables en tu
# proveedor de alojamiento (p. ej. Vercel → Settings → Environment Variables).
# NUNCA subas claves reales al repositorio.

# ── Supabase (obligatorio) ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo servidor: borrado de cuentas, webhooks de pago y devolución de cuota.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para enlaces de email y redirecciones de pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── IA: Anthropic Claude (obligatorio para escáner y recetas) ────────────────
ANTHROPIC_API_KEY=
# Modelo. Por defecto claude-opus-5-5. Alternativas más baratas: claude-sonnet-5-5, claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# ── Opcionales ───────────────────────────────────────────────────────────────
# Búsqueda ampliada en USDA FoodData Central (clave gratuita en https://fdc.nal.usda.gov/api-key-signup)
FDC_API_KEY=
# Fotos de referencia (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=
# Pagos con Stripe (https://dashboard.stripe.com/apikeys y Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
